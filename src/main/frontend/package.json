{
  "name": "delivery-platform-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS v4 + FlyonUI styling for the Delivery Platform server-rendered UI.",
  "scripts": {
    "build:css": "tailwindcss -i ./app.css -o ../../../build/generated/frontend/static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./app.css -o ../../../build/generated/frontend/static/css/app.css --watch"
  },
  "dependencies": {
    "flyonui": "^2.0.0"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.0",
    "@iconify/tailwind4": "^1.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
